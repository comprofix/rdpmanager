<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Windows Forms hosts the RDP control (milestone 7) and provides the Task Dialog used for prompts. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RDPManager</AssemblyName>
    <RootNamespace>RDPManager.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- WFO0003 asks for DPI to be set through Windows Forms. This is an Avalonia app that only hosts
         Windows Forms controls, so DPI awareness (Per-Monitor V2) stays in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="RoyalApps.Community.Avalonia.Windows" Version="1.4.0" />
    <PackageReference Include="RoyalApps.Community.Rdp.WinForms" Version="2.0.9" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDPManager.Core\RDPManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep Windows Forms types out of the global namespace so they don't clash with Avalonia's (Application, Button, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDPManager.App.Tests" />
  </ItemGroup>

</Project>
