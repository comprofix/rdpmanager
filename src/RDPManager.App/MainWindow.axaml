<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RDPManager.App.ViewModels"
        xmlns:views="using:RDPManager.App.Views"
        x:Class="RDPManager.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RDPManager"
        Width="1200" Height="760"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <!-- Tabs are shown with these views. Colours come from App.axaml. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:SettingsTabViewModel">
      <views:SettingsTabView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProgramSettingsTabViewModel">
      <views:ProgramSettingsTabView />
    </DataTemplate>
    <DataTemplate DataType="vm:SessionTabViewModel">
      <views:SessionView Placement="Tab" />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Layout: DESIGN.md, Agreed layout; menus: DESIGN.md, Packaging and releases (Menus). -->
  <Grid x:Name="Root" DragDrop.AllowDrop="True">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="New _connection"
                  Command="{Binding NewConnectionCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
        <MenuItem Header="New _folder"
                  Command="{Binding NewFolderCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
        <Separator />
        <MenuItem Header="_Settings…" Command="{Binding OpenProgramSettingsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Rename" InputGesture="F2"
                  Command="{Binding Tree.BeginRenameCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
        <MenuItem Header="D_uplicate"
                  Command="{Binding Tree.DuplicateCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
        <MenuItem Header="_Delete" InputGesture="Delete"
                  Command="{Binding Tree.DeleteCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Full screen" Command="{Binding FullScreenCommand}" />
        <MenuItem Header="{Binding Messages.MenuText, FallbackValue=_Messages}" Command="{Binding Messages.ToggleCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="10,3" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding SessionStatus}" Opacity="0.7" VerticalAlignment="Center" />
        <!-- DESIGN: the Messages panel does not open by itself; this link opens it. -->
        <Button Grid.Column="1" Classes="link" Margin="0,0,16,0" Padding="0"
                IsVisible="{Binding Messages.HasNewErrors, FallbackValue=False}"
                Content="{Binding Messages.NewErrorsText}" Command="{Binding Messages.OpenCommand}"
                Foreground="{DynamicResource ErrorForeground}" ToolTip.Tip="Show messages" />
        <TextBlock Grid.Column="2" Text="{Binding SourceStatus}" Opacity="0.7" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Messages panel (DESIGN: Messages panel): this run's warnings and errors. -->
    <Border DockPanel.Dock="Bottom" Height="170" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
            IsVisible="{Binding Messages.IsOpen, FallbackValue=False}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="10,4">
          <TextBlock Grid.Column="0" Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="Open log folder" Margin="0,0,14,0"
                  Command="{Binding Messages.OpenLogFolderCommand}" ToolTip.Tip="{Binding Messages.LogFolder}" />
          <Button Grid.Column="2" Classes="link" Content="Clear" Margin="0,0,14,0" Command="{Binding Messages.ClearCommand}" />
          <Button Grid.Column="3" Content="✕" Padding="4,0" FontSize="11" Background="Transparent" BorderThickness="0"
                  Command="{Binding Messages.CloseCommand}" ToolTip.Tip="Hide messages" />
        </Grid>
        <Panel>
          <TextBlock Text="No warnings or errors." Opacity="0.5" Margin="10,4"
                     IsVisible="{Binding !Messages.Rows.Count, FallbackValue=False}" />
          <ListBox ItemsSource="{Binding Messages.Rows}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageRow">
                <Grid ColumnDefinitions="70,70,*" ToolTip.Tip="{Binding Message}">
                  <TextBlock Grid.Column="0" Text="{Binding Time}" Opacity="0.7" />
                  <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold"
                             Classes.error="{Binding IsError}" Classes="level" />
                  <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="TextBlock.level">
                <Setter Property="Foreground" Value="{DynamicResource WarningForeground}" />
              </Style>
              <Style Selector="TextBlock.level.error">
                <Setter Property="Foreground" Value="{DynamicResource ErrorForeground}" />
              </Style>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="260,4,*">
      <TreeView x:Name="Tree" Grid.Column="0"
                ItemsSource="{Binding Tree.Items}"
                SelectedItem="{Binding Tree.SelectedItem, Mode=TwoWay}"
                DragDrop.AllowDrop="True">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeItemViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
          <!-- Drag-and-drop: the folder an item would be dropped into. -->
          <!-- Defaults live in a style, not on the Border itself: a value set directly on a control
               outranks styles, which would stop the drop-target style from taking effect. -->
          <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
          </Style>
          <Style Selector="Border.row.dropTarget">
            <Setter Property="Background" Value="{DynamicResource DropTargetBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DropTargetBorder}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Connect" InputGesture="Enter"
                      Command="{Binding ConnectCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <MenuItem Header="Settings"
                      Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <Separator />
            <MenuItem Header="New connection"
                      Command="{Binding NewConnectionCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <MenuItem Header="New folder"
                      Command="{Binding NewFolderCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <Separator />
            <MenuItem Header="Rename" InputGesture="F2"
                      Command="{Binding Tree.BeginRenameCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <MenuItem Header="Duplicate"
                      Command="{Binding Tree.DuplicateCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
            <MenuItem Header="Delete" InputGesture="Delete"
                      Command="{Binding Tree.DeleteCommand}" CommandParameter="{Binding Tree.SelectedItem}" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:TreeItemViewModel" ItemsSource="{Binding Children}">
            <Border Classes="row" Classes.dropTarget="{Binding IsDropTarget}"
                    BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="-4,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="14" Height="14" IsVisible="{Binding IsSource}"
                        Data="M12,3 L2,11 L5,11 L5,21 L10,21 L10,15 L14,15 L14,21 L19,21 L19,11 L22,11 Z" />
              <PathIcon Width="14" Height="14" IsVisible="{Binding IsFolder}" Foreground="#D8A200"
                        Data="M2,5 L9,5 L11,7 L22,7 L22,20 L2,20 Z" />
              <PathIcon Width="14" Height="14" IsVisible="{Binding IsConnection}"
                        Data="M2,3 L22,3 L22,16 L2,16 Z M10,16 L14,16 L14,19 L17,19 L17,21 L7,21 L7,19 L10,19 Z" />
              <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditing}" VerticalAlignment="Center"
                         FontWeight="{Binding IsSource, Converter={x:Static vm:Converters.BoolToSemiBold}}" />
              <TextBox Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                       MinWidth="140" Padding="4,1" Classes="rename" />
            </StackPanel>
            </Border>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Panel Grid.Column="2">
        <TextBlock Text="Open a connection or its settings from the tree." Opacity="0.5" IsVisible="{Binding !HasTabs}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TabControl x:Name="Tabs" IsVisible="{Binding HasTabs}" ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Padding="0">
          <TabControl.Styles>
            <Style Selector="TextBlock.tabTitle.inactive">
              <Setter Property="FontStyle" Value="Italic" />
              <Setter Property="Opacity" Value="0.75" />
            </Style>
          </TabControl.Styles>
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                <StackPanel.ContextMenu>
                  <!-- Session tabs only (DESIGN: Session behaviour). -->
                  <ContextMenu IsVisible="{Binding IsSession}" x:CompileBindings="False">
                    <MenuItem Header="Full screen" Command="{Binding FullScreenCommand}" />
                    <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                    <MenuItem Header="Reconnect" Command="{Binding ReconnectCommand}" />
                    <MenuItem Header="{Binding UndockMenuText}" Command="{Binding ToggleUndockCommand}" />
                    <Separator />
                    <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                           Classes="tabTitle" Classes.inactive="{Binding IsInactive}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ModifiedDot}" IsVisible="{Binding IsModified}"
                         VerticalAlignment="Center" ToolTip.Tip="Unsaved changes" />
                <Button Content="✕" Padding="4,0" FontSize="11" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" ToolTip.Tip="Close"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
        </TabControl>
      </Panel>
    </Grid>
  </DockPanel>

  <!-- Drag-and-drop: the item being dragged follows the pointer. -->
  <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
    <Border x:Name="DragGhost" IsVisible="False" Opacity="0.85" Padding="8,3" CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource DropTargetBorder}"
            Background="{DynamicResource DragGhostBackground}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon x:Name="DragGhostIcon" Width="14" Height="14" />
        <TextBlock x:Name="DragGhostText" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Canvas>
  </Grid>
</Window>
